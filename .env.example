# Postgres
DATABASE_URL=postgresql://luki:changeme@db:5432/luki
POSTGRES_PASSWORD=changeme

# Auth.js / Keycloak (admin login)
AUTH_SECRET=
AUTH_URL=https://vote.example.com
AUTH_TRUST_HOST=true
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/myrealm
KEYCLOAK_CLIENT_ID=luki-admin
KEYCLOAK_CLIENT_SECRET=
# Name of a CLIENT role on the KEYCLOAK_CLIENT_ID client above (Keycloak: Clients >
# this client > Roles) - not a realm role. Assign it to admin users' accounts.
ADMIN_ROLE_NAME=voting-admin
# Local dev only - lets /admin work without a real Keycloak login. Only takes effect
# when NODE_ENV isn't "production" (the Docker image always sets it to "production",
# so this can never activate in that build regardless of this value). Never set this
# in a real deployment's env.
DEV_BYPASS_ADMIN_AUTH=false

# Keycloak admin API (member registration / RSVP) - a separate confidential client
# with service accounts enabled, granted realm-management roles "manage-users" and
# "view-realm" (add "manage-realm" only if role lookups 403). Realm name is derived
# from KEYCLOAK_ISSUER above, not a separate var. Used to create Keycloak users for
# self-registered players, assign them the "app-luki-player" realm role, and send
# Keycloak's own execute-actions email so they can set a password.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Mail (OTP delivery)
MAILER_DRIVER=smtp
# MAILER_DRIVER=console  # local dev: logs the OTP instead of sending it
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LuKi Voting <no-reply@example.com>"

# Distinct secrets used for hashing - do not reuse AUTH_SECRET for any of these
EMAIL_HASH_SECRET=
OTP_PEPPER=
IP_HASH_SECRET=

APP_BASE_URL=https://vote.example.com

# Comma-separated list of hostnames allowed to invoke Server Actions in production
SERVER_ACTIONS_ALLOWED_ORIGINS=vote.example.com
