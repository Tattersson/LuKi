datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
}

/// The two roles every ballot votes on: one Captain pick, up to two distinct
/// Vice-Captain picks. See vote-service.ts for the per-role vote-count rules.
enum VotePosition {
  CAPTAIN
  VICE_CAPTAIN
}

model Election {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  status             ElectionStatus @default(DRAFT)
  publicSlug         String         @unique
  createdByEmail     String
  createdAt          DateTime       @default(now())
  openedAt           DateTime?
  closedAt           DateTime?
  /// Optional deadline: the in-app scheduler (see election-lifecycle.ts) closes
  /// the election automatically once this passes.
  closesAt           DateTime?
  /// Set once the closing results email has gone out, so closing twice (e.g. the
  /// scheduler and an admin racing) never sends it twice.
  resultsEmailSentAt DateTime?

  /// Round 1 unless this election is a tie-breaker round, in which case it's the
  /// parent's round + 1 (see tie-breaker-service.ts). Capped by MAX_TIE_BREAKER_ROUNDS.
  round              Int           @default(1)
  /// Null for a normal election. Set on a tie-breaker round to the single position
  /// it exists to decide - see tieBreakerSlots for how many seats are still open.
  tieBreakerPosition VotePosition?
  /// Null for a normal election. On a tie-breaker round, how many winner slots for
  /// tieBreakerPosition are still undecided and up for a re-vote among its candidates.
  tieBreakerSlots    Int?

  parentElectionId String?
  parentElection   Election?  @relation("TieBreakerRounds", fields: [parentElectionId], references: [id], onDelete: Cascade)
  childElections   Election[] @relation("TieBreakerRounds")

  candidates  Candidate[]
  votedEmails VotedEmail[]
  votes       Vote[]
  otpRequests OtpRequest[]
  otpSendLogs OtpSendLog[]

  /// Guards against double-creating the same round (e.g. a racing scheduler/admin
  /// close); Postgres treats NULLs as distinct so normal elections never collide.
  @@unique([parentElectionId, tieBreakerPosition])
}

model Candidate {
  id          String   @id @default(cuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int      @default(0)
  votes       Vote[]

  /// Provenance only, not a real relation: on a tie-breaker round's candidates, the
  /// id of the original candidate this row was copied from. Candidates belong to
  /// exactly one election, so a tie-breaker roster is always a fresh copy.
  sourceCandidateId String?
}

/// Proves "this email already voted in this election". Deliberately carries
/// no reference to Vote / candidateId - see vote-service.ts for why.
///
/// `email` (plaintext) is kept solely to send the results notice once the
/// election closes - a deliberate, explicitly-approved exception to this
/// project's default of never persisting a voter's plaintext email. It is
/// never joined against Vote and never shown anywhere in the admin UI.
model VotedEmail {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  emailHash  String
  email      String
  votedAt    DateTime @default(now())

  @@unique([electionId, emailHash])
}

/// An anonymous ballot. Deliberately carries no emailHash and no id shared
/// with VotedEmail - see vote-service.ts for why.
model Vote {
  id          String       @id @default(cuid())
  electionId  String
  election    Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate    @relation(fields: [candidateId], references: [id])
  position    VotePosition
  castAt      DateTime     @default(now())
}

model OtpRequest {
  id          String    @id @default(cuid())
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  emailHash   String
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([electionId, emailHash, consumedAt, expiresAt])
}

/// Rate-limit bookkeeping only.
model OtpSendLog {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  emailHash  String
  ipHash     String
  createdAt  DateTime @default(now())

  @@index([electionId, emailHash, createdAt])
  @@index([ipHash, createdAt])
}

enum PlayerPosition {
  MV // Maalivahti (Goalkeeper)
  FW // Forward
  D // Defenseman
}

enum StickSide {
  LEFT
  RIGHT
}

/// Created only once a registrant has verified their email via the self-service
/// registration flow (see the `players` feature) - there is no unverified draft state.
model Player {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  position        PlayerPosition
  /// Optional - can be filled in later (self-reported now, may be synced from the
  /// Finnish Hockey Association API in the future).
  heightCm        Int?
  /// Optional - see heightCm.
  weightKg        Int?
  stickSide       StickSide
  birthDate       DateTime
  email           String         @unique
  emailVerifiedAt DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Keycloak user id ("sub"), set once a login has been provisioned (auto on
  /// self-registration, or via the admin "Create login" backfill action). Null for
  /// players who registered before this existed or whose provisioning hasn't run yet.
  keycloakId      String?        @unique

  rsvps PracticeRsvp[]
}

enum PracticeStatus {
  SCHEDULED
  CANCELLED
}

/// One row per practice occurrence. A recurring practice materializes N rows sharing
/// a seriesId at creation time (not a single RRULE row) so each occurrence can be
/// edited or cancelled independently, and so the ICS feed's UID/SEQUENCE work per
/// occurrence - see the `practices` feature's domain/ics.ts.
model Practice {
  id           String         @id @default(cuid())
  /// Matches games' TeamKey ("luki-2div" | "luki-team") - see features/games/constants.ts.
  teamKey      String
  /// Optional override; the public UI derives a default title from the team label
  /// when this is blank.
  title        String?
  startAt      DateTime
  endAt        DateTime
  locationName String
  locationLat  Float?
  locationLng  Float?
  description  String?
  /// Shared by every occurrence generated from one recurring create; null for a
  /// one-off practice.
  seriesId     String?
  status       PracticeStatus @default(SCHEDULED)
  /// Bumped on every edit; drives the ICS feed's SEQUENCE so subscribed calendars
  /// treat an edited occurrence as updated rather than a duplicate. Games hardcodes
  /// SEQUENCE:0 because games are never edited locally - practices are, so that
  /// shortcut doesn't apply here.
  version      Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  rsvps PracticeRsvp[]

  @@index([teamKey, startAt])
  @@index([seriesId])
}

enum RsvpStatus {
  IN
  OUT
}

/// Schema and read side only for now - there is no write path until member login
/// (Keycloak) lands, see the `practices` feature's rsvp-repository.ts.
model PracticeRsvp {
  id         String     @id @default(cuid())
  practiceId String
  practice   Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     RsvpStatus
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([practiceId, playerId])
}

/// Standalone email-verification OTP for self-service player registration. Unlike
/// voting's OtpRequest, this isn't scoped to any parent entity - there is one general
/// registration link, not one per player, so a Player row doesn't exist yet when this
/// is created.
model PlayerOtpRequest {
  id          String    @id @default(cuid())
  emailHash   String
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([emailHash, consumedAt, expiresAt])
}

/// Rate-limit bookkeeping only.
model PlayerOtpSendLog {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
}
